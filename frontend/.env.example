# Server-side base URL of the FastAPI service (never exposed to the browser).
# Local (host):     http://localhost:8000/api/v1
# docker-compose:   http://backend:8000/api/v1
API_BASE_URL=http://localhost:8000/api/v1

# Name of the httpOnly session cookie that holds the attorney JWT.
SESSION_COOKIE_NAME=projectalma_session

# Set to "1" in production (HTTPS) so the session cookie is marked Secure.
COOKIE_SECURE=0
