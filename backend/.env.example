# ---- App ----
ENVIRONMENT=local            # local | test | staging | production
DEBUG=true                   # MUST be false in production
API_V1_PREFIX=/api/v1
DOCS_ENABLED=true            # /docs is always disabled when ENVIRONMENT=production
CORS_ORIGINS=http://localhost:3000

# ---- Database ----
# App uses the async driver; Alembic/scripts derive the sync DSN automatically.
# docker-compose overrides host to "db". SQLite works for a no-infra local run:
#   DATABASE_URL=sqlite+aiosqlite:///./var/dev.db
DATABASE_URL=postgresql+asyncpg://projectalma:projectalma@localhost:5432/projectalma
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
DB_STATEMENT_TIMEOUT_MS=10000
DB_ECHO=false

# ---- Auth ----
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_ISSUER=projectalma-api
BCRYPT_ROUNDS=12
SEED_ATTORNEY_EMAIL=attorney@projectalma.com
SEED_ATTORNEY_PASSWORD=changeme123
SEED_ATTORNEY_NAME=Attorney

# Attorney self-registration (POST /auth/register). Gated by an invite code.
# In production: rotate the code, or set ATTORNEY_SIGNUP_ENABLED=false and
# provision accounts directly. Boot fails in production if the code is "welcome".
ATTORNEY_SIGNUP_ENABLED=true
ATTORNEY_SIGNUP_CODE=welcome

# ---- Rate limiting (in-process fixed window) ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LEAD_CREATE_PER_HOUR=20
RATE_LIMIT_LOGIN_PER_15MIN=10
RATE_LIMIT_SIGNUP_PER_HOUR=5

# ---- Email (Resend) ----
# Leave RESEND_API_KEY blank to log emails to the console instead of sending.
RESEND_API_KEY=
EMAIL_FROM=ProjectAlma <noreply@projectalma.com>
ATTORNEY_NOTIFICATION_EMAIL=intake@projectalma.com
FRONTEND_BASE_URL=http://localhost:3000

# ---- Resume storage ----
STORAGE_BACKEND=local        # local | s3
STORAGE_LOCAL_DIR=./var/resumes
MAX_RESUME_BYTES=10485760

# ---- S3 (only when STORAGE_BACKEND=s3) ----
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=
# S3_PRESIGN_EXPIRY_SECONDS=3600
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
